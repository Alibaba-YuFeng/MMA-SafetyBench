# Export these variables in your shell. This file is not loaded automatically.
VICTIM_API_KEY=
VICTIM_API_URL=https://api.example.com/v1
VICTIM_MODEL=
JUDGE_API_KEY=
JUDGE_API_URL=https://api.example.com/v1
JUDGE_MODEL=gpt-5
# Directory containing 01_Web_GUI_Testing, 02_Document_Analysis, etc.
MMA_DATA_ROOT=/path/to/MMA-SafetyBench
MMA_RESULTS_ROOT=results
# GUI original coordinate interpretation; select pixels or normalized explicitly
# when the provider's coordinate convention is known.
MMA_COORDINATE_SPACE=legacy
# Optional video-only settings (video renderer is not included upstream).
SILICONFLOW_API_KEY=
EMBEDDING_API_URL=
